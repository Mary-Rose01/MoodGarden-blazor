@page "/wall"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@using MoodGarden.Client.Models
@using MoodGarden.Client.Services
@inject WallService Walls
@inject ProfileService Profiles
@inject AuthService Auth
@inject NavigationManager Nav

<h1>Vibe Wall 💬</h1>

<div class="card">
    <div class="row">
        <select class="mg-in" @bind="moodKey">
            @foreach (var m in GardenState.Moods)
            {
                <option value="@m.Key">@m.Emoji @m.Name</option>
            }
        </select>
        <select class="mg-in" @bind="paws">
            @for (var n = 1; n <= 5; n++)
            {
                <option value="@n">@string.Concat(Enumerable.Repeat("🐾", n))</option>
            }
        </select>
    </div>
    <textarea class="mg-in" rows="2" maxlength="240" style="margin:8px 0" @bind="text" placeholder="Share how you feel…"></textarea>
    <button type="button" class="btn p" disabled="@saving" @onclick="PostAsync">@(saving ? "Posting..." : "Post")</button>
</div>

<div class="row" style="margin-bottom:12px">
    <select class="mg-in" style="max-width:220px" @bind="filter">
        <option value="recent">Recent</option>
        <option value="top">Most supported</option>
        @foreach (var m in GardenState.Moods)
        {
            <option value="@m.Key">@m.Emoji @m.Name</option>
        }
    </select>
</div>

@if (!string.IsNullOrEmpty(error))
{
    <div class="card" style="border-color:#dc2626;color:#dc2626;font-weight:700">@error</div>
}

@if (!Feed.Any())
{
    <div class="card">No posts for this filter yet.</div>
}
else
{
    @foreach (var p in Feed)
    {
        var m = GardenState.Find(p.MoodName);
        var myReaction = reactions.FirstOrDefault(r => r.PostId == p.Id && r.ClientId == clientId)?.Reaction;

        <div class="card">
            <div class="row">
                <span style="font-size:28px">@(string.IsNullOrWhiteSpace(p.AvatarEmoji) ? "🐱" : p.AvatarEmoji)</span>
                <b>@p.Author</b>
                <span class="pill" style="background:@m.ColorHex">@m.Emoji @m.Name</span>
                <span>@string.Concat(Enumerable.Repeat("🐾", Math.Clamp(p.Paws, 1, 5)))</span>
                <span class="mut">@GardenState.FormatDate(p.At)</span>
            </div>
            <p>@p.Text</p>
            <div class="row">
                @foreach (var r in ReactionDefs)
                {
                    var cnt = reactions.Count(x => x.PostId == p.Id && x.Reaction == r.Key);
                    var active = myReaction == r.Key;
                    <button type="button" class="btn s @(active ? "p" : "")" @onclick="() => ToggleReactionAsync(p.Id, r.Key)">
                        @r.Label @cnt
                    </button>
                }
                <button type="button" class="btn s" @onclick="ReportAsync">Report</button>
            </div>
        </div>
    }
}

@if (!string.IsNullOrEmpty(toastMsg))
{
    <div id="t"><div class="ts">@toastMsg</div></div>
}

@code {
    private static readonly (string Key, string Label)[] ReactionDefs =
    {
        ("paw", "🐾 Support"),
        ("hug", "🫂 Hug"),
        ("grow", "🌱 Grow"),
        ("love", "💗 Love")
    };

    private List<WallPost> posts = new();
    private List<WallReaction> reactions = new();
    private UserProfile profile = new();
    private string clientId = "";

    private string moodKey = "happy";
    private int paws = 3;
    private string text = "";
    private string filter = "recent";
    private bool saving;
    private string? error;
    private string? toastMsg;

    private IEnumerable<WallPost> Feed
    {
        get
        {
            if (filter == "top")
                return posts.OrderByDescending(p => reactions.Count(r => r.PostId == p.Id)).ThenByDescending(p => p.At);
            if (filter != "recent")
                return posts.Where(p => GardenState.Find(p.MoodName).Key == filter).OrderByDescending(p => p.At);
            return posts.OrderByDescending(p => p.At);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsSignedIn) { Nav.NavigateTo("login", replace: true); return; }
        try
        {
            clientId = await Profiles.GetClientIdAsync();
            profile = await Profiles.GetOrCreateProfileAsync();
            posts = await Walls.GetAllAsync();
            reactions = await Walls.GetReactionsAsync();
        }
        catch (Exception ex)
        {
            error = $"Could not load Vibe Wall: {ex.Message}";
        }
    }

    private async Task PostAsync()
    {
        if (string.IsNullOrWhiteSpace(text))
        {
            await ShowToastAsync("Write something first");
            return;
        }
        saving = true;
        error = null;
        try
        {
            var mood = GardenState.Find(moodKey);
            var authorName = string.IsNullOrWhiteSpace(profile.DisplayName) ? profile.Username : profile.DisplayName;
            var newPost = new WallPost
            {
                ClientId = clientId,
                Author = string.IsNullOrWhiteSpace(authorName) ? "Alex" : authorName,
                AvatarEmoji = string.IsNullOrWhiteSpace(profile.AvatarEmoji) ? "🐱" : profile.AvatarEmoji,
                MoodName = mood.Name,
                Paws = paws,
                Text = text.Trim(),
                At = DateTime.UtcNow,
                UpdatedAt = DateTime.UtcNow
            };
            var created = await Walls.AddAsync(newPost);
            posts.Insert(0, created);
            text = "";
            await ShowToastAsync("Posted to the wall");
        }
        catch (Exception ex)
        {
            error = $"Could not post: {ex.Message}";
        }
        finally
        {
            saving = false;
        }
    }

    private async Task ToggleReactionAsync(Guid postId, string reactionKey)
    {
        try
        {
            await Walls.ToggleReactionAsync(postId, clientId, reactionKey);
            reactions = await Walls.GetReactionsAsync();
        }
        catch (Exception ex)
        {
            error = $"Could not save reaction: {ex.Message}";
        }
    }

    private Task ReportAsync() => ShowToastAsync("Reported. Thanks for keeping the wall kind 💗");

    private async Task ShowToastAsync(string msg)
    {
        toastMsg = msg;
        StateHasChanged();
        await Task.Delay(3200);
        if (toastMsg == msg)
        {
            toastMsg = null;
            StateHasChanged();
        }
    }
}
