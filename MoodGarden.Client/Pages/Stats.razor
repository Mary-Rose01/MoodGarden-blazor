// Add at the top of Stats.razor:
@using MoodGarden.Client.Models
@inject Supabase.Client Supabase

// Replace `var myCount = Garden.Recent.Count;` with:
    var myCount = recentPlantings.Count;

// Update @code block:
@code {
    private static readonly int[] globalValues = { 32, 8, 12, 48, 24, 15, 58, 18 };
    private List<Planting> recentPlantings = new();
    private bool showMine;

    protected override async Task OnInitializedAsync()
    {
        var cutoff = DateTime.UtcNow.AddHours(-24);
        var response = await Supabase
            .From<Planting>()
            .Where(x => x.DeletedAt == null && x.At >= cutoff)
            .Get();

        recentPlantings = response.Models;
    }

    private List<(Mood Mood, int Value)> Global =>
        GardenState.Moods.Select((m, i) => (m, globalValues[i])).ToList();

    private List<(Mood Mood, int Value)> Mine
    {
        get
        {
            var total = Math.Max(recentPlantings.Count, 1);
            return GardenState.Moods
                .Select(m => (m, (int)Math.Round(100.0 * recentPlantings.Count(p => p.MoodName == m.Name) / total)))
                .ToList();
        }
    }
}