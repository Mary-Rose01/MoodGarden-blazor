@page "/login"
@page "/register"
@page "/forgot-password"
@layout MoodGarden.Client.Components.AuthLayout
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@using MoodGarden.Client.Services
@inject AuthService AuthSvc
@inject ProfileService Profiles
@inject NavigationManager Nav

<div style="max-width:460px;margin:10px auto">
    @if (AuthSvc.IsSignedIn)
    {
        <div class="card">
            <h1>Welcome back! 🌱</h1>
            <p class="mut">Signed in as <b>@AuthSvc.Email</b></p>
            <div class="row" style="margin-top:12px">
                <a class="btn p" href="">🌷 Go to Garden</a>
                <a class="btn" href="profile">🐾 Edit Profile</a>
                <button type="button" class="btn" disabled="@busy" @onclick="SignOutAsync">Log Out</button>
            </div>
        </div>
    }
    else
    {
        <div class="row" style="margin-bottom:14px">
            <button type="button" class="btn s @(mode == "login" ? "p" : "")" @onclick='() => SwitchMode("login")'>🔑 Log In</button>
            <button type="button" class="btn s @(mode == "register" ? "p" : "")" @onclick='() => SwitchMode("register")'>🌱 Register</button>
            <button type="button" class="btn s @(mode == "forgot" ? "p" : "")" @onclick='() => SwitchMode("forgot")'>💌 Reset Password</button>
        </div>

        @if (!string.IsNullOrEmpty(error))
        {
            <div class="card" style="border-color:#dc2626;color:#dc2626;font-weight:700">@error</div>
        }

        @if (!string.IsNullOrEmpty(success))
        {
            <div class="card" style="background:var(--gr);color:#1E1E1E;font-weight:700">@success</div>
        }

        @if (mode == "login")
        {
            <form class="card" @onsubmit="LoginAsync" @onsubmit:preventDefault>
                <h1>Log In 🔑</h1>
                <p class="mut">Welcome back to your Mood Garden.</p>

                <label class="mut" style="display:block;margin-top:10px">Email</label>
                <input class="mg-in" type="email" required @bind="email" placeholder="you@example.com" />

                <label class="mut" style="display:block;margin-top:10px">Password</label>
                <input class="mg-in" type="password" required minlength="6" @bind="password" placeholder="••••••••" />

                <div class="row" style="margin-top:14px">
                    <button type="submit" class="btn p" disabled="@busy">@(busy ? "Signing in..." : "Log In")</button>
                    <button type="button" class="btn s" @onclick='() => SwitchMode("forgot")'>Forgot password?</button>
                </div>
            </form>
        }
        else if (mode == "register")
        {
            <form class="card" @onsubmit="RegisterAsync" @onsubmit:preventDefault>
                <h1>Create Account 🌱</h1>
                <p class="mut">Start growing your Mood Garden.</p>

                <label class="mut" style="display:block;margin-top:10px">Gardener Name</label>
                <input class="mg-in" type="text" maxlength="32" @bind="displayName" placeholder="Alex" />

                <label class="mut" style="display:block;margin-top:10px">Email</label>
                <input class="mg-in" type="email" required @bind="email" placeholder="you@example.com" />

                <label class="mut" style="display:block;margin-top:10px">Password (min 6 characters)</label>
                <input class="mg-in" type="password" required minlength="6" @bind="password" placeholder="••••••••" />

                <label class="mut" style="display:block;margin-top:10px">Confirm Password</label>
                <input class="mg-in" type="password" required minlength="6" @bind="confirmPassword" placeholder="••••••••" />

                <div class="row" style="margin-top:14px">
                    <button type="submit" class="btn p" disabled="@busy">@(busy ? "Creating..." : "Register")</button>
                    <button type="button" class="btn s" @onclick='() => SwitchMode("login")'>Already have an account?</button>
                </div>
            </form>
        }
        else
        {
            <form class="card" @onsubmit="ResetPasswordAsync" @onsubmit:preventDefault>
                <h1>Reset Password 💌</h1>
                <p class="mut">We'll email you a link to reset your password.</p>

                <label class="mut" style="display:block;margin-top:10px">Email</label>
                <input class="mg-in" type="email" required @bind="email" placeholder="you@example.com" />

                <div class="row" style="margin-top:14px">
                    <button type="submit" class="btn p" disabled="@busy">@(busy ? "Sending..." : "Send Reset Link")</button>
                    <button type="button" class="btn s" @onclick='() => SwitchMode("login")'>Back to Log In</button>
                </div>
            </form>
        }
    }
</div>

@code {
    private string mode = "login";
    private string displayName = "";
    private string email = "";
    private string password = "";
    private string confirmPassword = "";
    private bool busy;
    private string? error;
    private string? success;

    protected override void OnInitialized()
    {
        if (AuthSvc.IsSignedIn)
        {
            Nav.NavigateTo("", replace: true);
        }
    }

    protected override void OnParametersSet()
    {
        var path = Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0].Trim('/').ToLowerInvariant();
        mode = path switch
        {
            "register" => "register",
            "forgot-password" => "forgot",
            _ => "login"
        };
    }

    private void SwitchMode(string next)
    {
        mode = next;
        error = null;
        success = null;
    }

    private async Task LoginAsync()
    {
        busy = true;
        error = null;
        success = null;
        try
        {
            var session = await AuthSvc.SignInAsync(email, password);
            if (session?.User is null)
            {
                error = "Could not sign in. Check your email and password.";
                return;
            }
            await Profiles.GetOrCreateProfileAsync();
            Nav.NavigateTo("");
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task RegisterAsync()
    {
        if (password != confirmPassword)
        {
            error = "Passwords do not match.";
            return;
        }
        busy = true;
        error = null;
        success = null;
        try
        {
            var session = await AuthSvc.SignUpAsync(email, password, displayName);
            if (session?.AccessToken is not null)
            {
                var profile = await Profiles.GetOrCreateProfileAsync();
                if (!string.IsNullOrWhiteSpace(displayName))
                {
                    profile.Username = displayName.Trim();
                    profile.DisplayName = displayName.Trim();
                }
                profile.AuthUserId = AuthSvc.CurrentUserGuid;
                await Profiles.SaveProfileAsync(profile);
                Nav.NavigateTo("");
            }
            else
            {
                success = "Account created! Check your email to confirm your address, then log in.";
                mode = "login";
                password = "";
                confirmPassword = "";
            }
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task ResetPasswordAsync()
    {
        busy = true;
        error = null;
        success = null;
        try
        {
            await AuthSvc.SendPasswordResetAsync(email);
            success = "Password reset email sent! Check your inbox.";
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task SignOutAsync()
    {
        busy = true;
        try
        {
            await AuthSvc.SignOutAsync();
            success = "Signed out.";
        }
        finally
        {
            busy = false;
        }
    }
}
