@page "/diary"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@using MoodGarden.Client.Models
@using MoodGarden.Client.Services
@inject PlantingService Plantings
@inject ProfileService Profiles
@inject AuthService Auth
@inject NavigationManager Nav

<h1>My Diary 📖</h1>
<p class="mut">@plantings.Count entries · private to you.</p>

<div class="row" style="margin:10px 0">
    <input class="mg-in" placeholder="Search…" @bind="search" @bind:event="oninput" />
    <select class="mg-in" @bind="moodFilter">
        <option value="">All moods</option>
        @foreach (var m in GardenState.Moods)
        {
            <option value="@m.Key">@m.Emoji @m.Name</option>
        }
    </select>
    <select class="mg-in" @bind="sortOrder">
        <option value="new">Newest</option>
        <option value="old">Oldest</option>
    </select>
    <button type="button" class="btn p" @onclick="OpenNewModal">+ New entry</button>
</div>

@if (!string.IsNullOrEmpty(error))
{
    <div class="card" style="border-color:#dc2626;color:#dc2626;font-weight:700">@error</div>
}

@if (loading)
{
    <div class="card">Loading your garden diary... 🌱</div>
}
else if (!Filtered.Any())
{
    <div class="card">🌱 No entries yet. Plant your first mood!</div>
}
else
{
    @foreach (var c in Filtered)
    {
        var mood = GardenState.Find(c.MoodName);
        var isHighlighted = highlightId == c.Id;
        <div class="card" style="border-left:12px solid @mood.ColorHex;@(isHighlighted ? "background:var(--yl);color:#1E1E1E" : "")">
            <div class="row">
                <span class="pill" style="background:@mood.ColorHex">@mood.Emoji @mood.Name</span>
                <span class="mut">@GardenState.FormatDate(c.At)</span>
            </div>
            <p>@(string.IsNullOrWhiteSpace(c.Note) ? "No note" : c.Note)</p>
            <div class="row">
                <button type="button" class="btn s" @onclick="() => OpenEditModal(c)">Edit</button>
                <button type="button" class="btn s" @onclick="() => OpenDeleteModal(c)">Delete</button>
                <button type="button" class="btn s" @onclick="() => detailsCat = c">Details</button>
                <a class="btn s" href="">View in garden</a>
            </div>
        </div>
    }
}

@if (showNewModal)
{
    <div class="ov" @onclick="CloseModals">
        <div class="card md" @onclick:stopPropagation>
            <h2>Plant a Mood 🌱</h2>
            <div class="mp">
                @foreach (var m in GardenState.Moods)
                {
                    var isSel = pickKey == m.Key;
                    <button type="button" class="@(isSel ? "sel" : "")" style="background:@m.ColorHex" @onclick="() => pickKey = m.Key">
                        <b>@m.Emoji</b>@m.Name<br /><span class="mut" style="font-weight:400">@m.Desc</span>
                    </button>
                }
            </div>
            <textarea class="mg-in" rows="3" maxlength="200" @bind="noteInput" placeholder="Optional note…"></textarea>
            <div class="row" style="margin-top:10px">
                <button type="button" class="btn p" disabled="@saving" @onclick="SaveNewAsync">@(saving ? "Saving..." : "Plant Cat")</button>
                <button type="button" class="btn" @onclick="CloseModals">Cancel</button>
            </div>
        </div>
    </div>
}

@if (detailsCat is not null)
{
    var m = GardenState.Find(detailsCat.MoodName);
    <div class="ov" @onclick="CloseModals">
        <div class="card md" @onclick:stopPropagation>
            <h2>@m.Emoji @m.Name</h2>
            <p class="mut">Planted @GardenState.FormatDate(detailsCat.At)</p>
            <p>@(string.IsNullOrWhiteSpace(detailsCat.Note) ? "No note" : detailsCat.Note)</p>
            <div class="row">
                <button type="button" class="btn s" @onclick="() => { var c = detailsCat; CloseModals(); OpenEditModal(c); }">Edit</button>
                <button type="button" class="btn s" @onclick="() => { var c = detailsCat; CloseModals(); OpenDeleteModal(c); }">Delete</button>
                <button type="button" class="btn s" @onclick="CloseModals">Close</button>
            </div>
        </div>
    </div>
}

@if (editingCat is not null)
{
    <div class="ov" @onclick="CloseModals">
        <div class="card md" @onclick:stopPropagation>
            <h2>Edit entry</h2>
            <div class="mp">
                @foreach (var m in GardenState.Moods)
                {
                    var isSel = pickKey == m.Key;
                    <button type="button" class="@(isSel ? "sel" : "")" style="background:@m.ColorHex" @onclick="() => pickKey = m.Key">
                        <b>@m.Emoji</b>@m.Name
                    </button>
                }
            </div>
            <textarea class="mg-in" rows="3" maxlength="200" @bind="noteInput"></textarea>
            <div class="row" style="margin-top:10px">
                <button type="button" class="btn p" disabled="@saving" @onclick="SaveEditAsync">@(saving ? "Saving..." : "Save")</button>
                <button type="button" class="btn" @onclick="CloseModals">Cancel</button>
            </div>
        </div>
    </div>
}

@if (deletingCat is not null)
{
    <div class="ov" @onclick="CloseModals">
        <div class="card md" @onclick:stopPropagation>
            <h2>Delete this entry?</h2>
            <p>This removes the cat from your garden and diary.</p>
            <div class="row">
                <button type="button" class="btn p" disabled="@saving" @onclick="ConfirmDeleteAsync">@(saving ? "Deleting..." : "Delete")</button>
                <button type="button" class="btn" @onclick="CloseModals">Keep</button>
            </div>
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(toastMsg))
{
    <div id="t"><div class="ts">@toastMsg</div></div>
}

@code {
    [SupplyParameterFromQuery(Name = "mood")] public string? QueryMood { get; set; }
    [SupplyParameterFromQuery(Name = "hl")] public Guid? QueryHighlight { get; set; }

    private List<Planting> plantings = new();
    private string search = "";
    private string moodFilter = "";
    private string sortOrder = "new";
    private Guid? highlightId;
    private bool loading = true;
    private bool saving;
    private string? error;
    private string? toastMsg;

    private bool showNewModal;
    private Planting? detailsCat;
    private Planting? editingCat;
    private Planting? deletingCat;
    private string? pickKey;
    private string noteInput = "";

    private IEnumerable<Planting> Filtered
    {
        get
        {
            var q = plantings.Where(c =>
                (string.IsNullOrEmpty(moodFilter) || GardenState.Find(c.MoodName).Key == moodFilter) &&
                (string.IsNullOrWhiteSpace(search) ||
                 (c.Note?.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false) ||
                 GardenState.Find(c.MoodName).Name.Contains(search, StringComparison.OrdinalIgnoreCase)));

            return sortOrder == "old" ? q.OrderBy(c => c.At) : q.OrderByDescending(c => c.At);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsSignedIn) { Nav.NavigateTo("login", replace: true); return; }
        if (!string.IsNullOrWhiteSpace(QueryMood))
            moodFilter = GardenState.Find(QueryMood).Key;
        highlightId = QueryHighlight;

        try
        {
            await Profiles.GetOrCreateProfileAsync();
            plantings = await Plantings.GetAllAsync();
        }
        catch (Exception ex)
        {
            error = $"Could not load diary from Supabase: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    private void OpenNewModal()
    {
        CloseModals();
        pickKey = null;
        noteInput = "";
        showNewModal = true;
    }

    private void OpenEditModal(Planting c)
    {
        CloseModals();
        editingCat = c;
        pickKey = GardenState.Find(c.MoodName).Key;
        noteInput = c.Note ?? "";
    }

    private void OpenDeleteModal(Planting c)
    {
        CloseModals();
        deletingCat = c;
    }

    private void CloseModals()
    {
        showNewModal = false;
        detailsCat = null;
        editingCat = null;
        deletingCat = null;
    }

    private async Task SaveNewAsync()
    {
        if (string.IsNullOrEmpty(pickKey))
        {
            await ShowToastAsync("Pick a mood first");
            return;
        }
        saving = true;
        error = null;
        try
        {
            var mood = GardenState.Find(pickKey);
            var now = DateTime.UtcNow;
            var created = await Plantings.AddAsync(new Planting
            {
                Emoji = mood.Emoji,
                MoodName = mood.Name,
                X = Random.Shared.Next(10, 90),
                Y = Random.Shared.Next(35, 90),
                At = now,
                UpdatedAt = now,
                Note = string.IsNullOrWhiteSpace(noteInput) ? null : noteInput.Trim()
            });
            plantings.Insert(0, created);
            CloseModals();
            await ShowToastAsync($"{mood.Emoji} planted!");
        }
        catch (Exception ex)
        {
            error = $"Save failed: {ex.Message}";
        }
        finally
        {
            saving = false;
        }
    }

    private async Task SaveEditAsync()
    {
        if (editingCat is null || string.IsNullOrEmpty(pickKey)) return;
        saving = true;
        error = null;
        try
        {
            var mood = GardenState.Find(pickKey);
            var cleaned = string.IsNullOrWhiteSpace(noteInput) ? null : noteInput.Trim();
            await Plantings.UpdateEntryAsync(editingCat.Id, mood.Emoji, mood.Name, cleaned);

            editingCat.Emoji = mood.Emoji;
            editingCat.MoodName = mood.Name;
            editingCat.Note = cleaned;
            editingCat.UpdatedAt = DateTime.UtcNow;
            CloseModals();
            await ShowToastAsync("Entry updated");
        }
        catch (Exception ex)
        {
            error = $"Update failed: {ex.Message}";
        }
        finally
        {
            saving = false;
        }
    }

    private async Task ConfirmDeleteAsync()
    {
        if (deletingCat is null) return;
        saving = true;
        error = null;
        try
        {
            await Plantings.SoftDeleteAsync(deletingCat.Id);
            plantings.RemoveAll(p => p.Id == deletingCat.Id);
            CloseModals();
            await ShowToastAsync("Entry deleted");
        }
        catch (Exception ex)
        {
            error = $"Delete failed: {ex.Message}";
        }
        finally
        {
            saving = false;
        }
    }

    private async Task ShowToastAsync(string msg)
    {
        toastMsg = msg;
        StateHasChanged();
        await Task.Delay(3200);
        if (toastMsg == msg)
        {
            toastMsg = null;
            StateHasChanged();
        }
    }
}
