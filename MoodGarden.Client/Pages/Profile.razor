@page "/profile"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@using MoodGarden.Client.Models
@using MoodGarden.Client.Services
@inject ProfileService Profiles
@inject PlantingService Plantings
@inject AuthService Auth
@inject NavigationManager Nav

<div class="row" style="margin-bottom:14px">
    <a class="btn s" href="settings">⚙️ General</a>
    <a class="btn s p" href="profile">🐾 Profile</a>
    <a class="btn s" href="achievements">🏆 Achievements</a>
    <a class="btn s" href="customize">🎨 Customize</a>
</div>

<h1>Profile 🐾</h1>

@if (!string.IsNullOrEmpty(error))
{
    <div class="card" style="border-color:#dc2626;color:#dc2626;font-weight:700">@error</div>
}

@{
    var streakDays = GardenState.CalculateStreak(plantings);
    var unlockedCount = GardenState.AchievementDefs.Count(a => GardenState.AchievementProgress(a, plantings) >= a.Target);
}

<div class="card">
    <div style="font-size:60px">@avatar</div>
    <h2>@(string.IsNullOrWhiteSpace(name) ? "Alex" : name)</h2>
    <p class="mut">Joined @profile.CreatedAt.ToLocalTime().ToString("MMM yyyy") · @plantings.Count cats · @streakDays-day streak · @unlockedCount achievements</p>
    <div class="row">
        <input class="mg-in" maxlength="32" @bind="name" />
        <select class="mg-in" @bind="avatar">
            @foreach (var av in Avatars)
            {
                <option value="@av">@av</option>
            }
        </select>
        <button type="button" class="btn p" disabled="@saving" @onclick="SaveAsync">@(saving ? "Saving..." : "Save")</button>
    </div>
</div>

@if (!string.IsNullOrEmpty(toastMsg))
{
    <div id="t"><div class="ts">@toastMsg</div></div>
}

@code {
    private static readonly string[] Avatars = { "🐱", "😺", "😸", "😻", "🙀" };

    private UserProfile profile = new();
    private List<Planting> plantings = new();
    private string name = "Alex";
    private string avatar = "🐱";
    private bool saving;
    private string? error;
    private string? toastMsg;

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsSignedIn) { Nav.NavigateTo("login", replace: true); return; }
        try
        {
            profile = await Profiles.GetOrCreateProfileAsync();
            name = string.IsNullOrWhiteSpace(profile.DisplayName) ? profile.Username : profile.DisplayName;
            avatar = string.IsNullOrWhiteSpace(profile.AvatarEmoji) ? "🐱" : profile.AvatarEmoji;
            plantings = await Plantings.GetAllAsync();
        }
        catch (Exception ex)
        {
            error = $"Could not load profile: {ex.Message}";
        }
    }

    private async Task SaveAsync()
    {
        saving = true;
        error = null;
        try
        {
            var clean = string.IsNullOrWhiteSpace(name) ? "Alex" : name.Trim();
            profile.Username = clean;
            profile.DisplayName = clean;
            profile.AvatarEmoji = avatar;
            profile = await Profiles.SaveProfileAsync(profile);
            await ShowToastAsync("Profile saved");
        }
        catch (Exception ex)
        {
            error = $"Could not save profile: {ex.Message}";
        }
        finally
        {
            saving = false;
        }
    }

    private async Task ShowToastAsync(string msg)
    {
        toastMsg = msg;
        StateHasChanged();
        await Task.Delay(3200);
        if (toastMsg == msg)
        {
            toastMsg = null;
            StateHasChanged();
        }
    }
}
