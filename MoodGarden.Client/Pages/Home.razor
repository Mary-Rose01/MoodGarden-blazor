@page "/"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@using MoodGarden.Client.Models
@using MoodGarden.Client.Services
@inject PlantingService Plantings
@inject ProfileService Profiles
@inject AuthService Auth
@inject NavigationManager Nav

@{
    var streakDays = GardenState.CalculateStreak(plantings);
    var topGroup = plantings.GroupBy(p => GardenState.Find(p.MoodName).Key).OrderByDescending(g => g.Count()).FirstOrDefault();
    var topMood = topGroup is null ? null : GardenState.Find(topGroup.Key);
    var hour = DateTime.Now.Hour;
    var greeting = hour < 12 ? "morning" : hour < 18 ? "afternoon" : "evening";
    var userName = string.IsNullOrWhiteSpace(profile.DisplayName) ? profile.Username : profile.DisplayName;
    var equipped = ProfileService.ParseEquipped(profile);
}

<h1>Good @greeting, @userName! 🌷</h1>
<p class="mut">@DateTime.Now.ToString("ddd MMM dd yyyy") · Your garden is growing beautifully.</p>

<div class="row" style="margin:10px 0">
    <span class="pill" style="background:var(--gr)">🐱 @plantings.Count cats</span>
    <span class="pill" style="background:var(--yl)">🌿 @streakDays days tended</span>
    <span class="pill" style="background:var(--pk)">Top mood: @(topMood is null ? "–" : $"{topMood.Emoji} {topMood.Name}")</span>
    <button type="button" class="btn p s" @onclick="OpenPlantModal">+ Plant a Mood</button>
</div>

@if (!string.IsNullOrEmpty(error))
{
    <div class="card" style="border-color:#dc2626;color:#dc2626;font-weight:700">@error</div>
}

<div id="gd" class="@(profile.NightMode ? "n" : "")">
    <span class="sun"></span>
    <span class="cl"></span>
    <span class="cl c2"></span>

    @for (var i = 0; i < equipped.Count; i++)
    {
        var item = equipped[i];
        var topPct = item == "🌳" ? 24 : (i % 2 == 1 ? 6 : 16);
        <span class="dec" style="left:@(8 + i * 13)%;top:@(topPct)%">@item</span>
    }

    <div class="gg">
        @foreach (var c in plantings.OrderBy(p => p.At))
        {
            var mood = GardenState.Find(c.MoodName);
            var isSeedling = (DateTime.UtcNow - c.At).TotalSeconds < 3;
            <button type="button" class="pl" title="@mood.Name" @onclick="() => selectedCat = c">
                @(isSeedling ? "🌱" : mood.Emoji)
            </button>
        }
        @for (var i = 0; i < 6; i++)
        {
            <button type="button" class="pl e" aria-label="Plant here" @onclick="OpenPlantModal">+</button>
        }
    </div>
</div>

<p class="mut">Tap an empty plot to plant. Cats grow in order, like a forest.</p>

<div class="card br">
    <div class="bc"></div>
    <div>
        <h3>Take a slow breath</h3>
        <p class="mut" style="margin:0">In for 4, out for 6. Longer exhales help the body settle.</p>
    </div>
</div>

<div class="row">
    @foreach (var m in GardenState.Moods)
    {
        <span class="pill" style="background:@m.ColorHex">@m.Emoji @m.Name</span>
    }
</div>

@if (showPlantModal)
{
    <div class="ov" @onclick="CloseModals">
        <div class="card md" @onclick:stopPropagation>
            <h2>Plant a Mood 🌱</h2>
            <div class="mp">
                @foreach (var m in GardenState.Moods)
                {
                    var isSel = pickKey == m.Key;
                    <button type="button" class="@(isSel ? "sel" : "")" style="background:@m.ColorHex" @onclick="() => pickKey = m.Key">
                        <b>@m.Emoji</b>@m.Name<br /><span class="mut" style="font-weight:400">@m.Desc</span>
                    </button>
                }
            </div>
            <textarea class="mg-in" rows="3" maxlength="200" @bind="noteInput" placeholder="Optional note…"></textarea>
            <div class="row" style="margin-top:10px">
                <button type="button" class="btn p" disabled="@saving" @onclick="SaveNewPlantingAsync">@(saving ? "Saving..." : "Plant Cat")</button>
                <button type="button" class="btn" @onclick="CloseModals">Cancel</button>
            </div>
        </div>
    </div>
}

@if (selectedCat is not null && !showEditModal && !showDeleteModal)
{
    var m = GardenState.Find(selectedCat.MoodName);
    <div class="ov" @onclick="CloseModals">
        <div class="card md" @onclick:stopPropagation>
            <h2>@m.Emoji @m.Name</h2>
            <p class="mut">Planted @GardenState.FormatDate(selectedCat.At)</p>
            <p>@(string.IsNullOrWhiteSpace(selectedCat.Note) ? "No note" : selectedCat.Note)</p>
            <div class="row">
                <button type="button" class="btn s" @onclick="OpenEditModal">Edit</button>
                <button type="button" class="btn s" @onclick="() => showDeleteModal = true">Delete</button>
                <button type="button" class="btn s" @onclick="OpenInDiary">Open in diary</button>
                <button type="button" class="btn s" @onclick="CloseModals">Close</button>
            </div>
        </div>
    </div>
}

@if (selectedCat is not null && showEditModal)
{
    <div class="ov" @onclick="CloseModals">
        <div class="card md" @onclick:stopPropagation>
            <h2>Edit entry</h2>
            <div class="mp">
                @foreach (var m in GardenState.Moods)
                {
                    var isSel = pickKey == m.Key;
                    <button type="button" class="@(isSel ? "sel" : "")" style="background:@m.ColorHex" @onclick="() => pickKey = m.Key">
                        <b>@m.Emoji</b>@m.Name
                    </button>
                }
            </div>
            <textarea class="mg-in" rows="3" maxlength="200" @bind="noteInput"></textarea>
            <div class="row" style="margin-top:10px">
                <button type="button" class="btn p" disabled="@saving" @onclick="SaveEditAsync">@(saving ? "Saving..." : "Save")</button>
                <button type="button" class="btn" @onclick="CloseModals">Cancel</button>
            </div>
        </div>
    </div>
}

@if (selectedCat is not null && showDeleteModal)
{
    <div class="ov" @onclick="CloseModals">
        <div class="card md" @onclick:stopPropagation>
            <h2>Delete this entry?</h2>
            <p>This removes the cat from your garden and diary.</p>
            <div class="row">
                <button type="button" class="btn p" disabled="@saving" @onclick="ConfirmDeleteAsync">@(saving ? "Deleting..." : "Delete")</button>
                <button type="button" class="btn" @onclick="() => showDeleteModal = false">Keep</button>
            </div>
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(toastMsg))
{
    <div id="t"><div class="ts">@toastMsg</div></div>
}

@code {
    private List<Planting> plantings = new();
    private UserProfile profile = new();
    private string? error;
    private string? toastMsg;
    private bool saving;

    private bool showPlantModal;
    private bool showEditModal;
    private bool showDeleteModal;
    private Planting? selectedCat;
    private string? pickKey;
    private string noteInput = "";

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsSignedIn) { Nav.NavigateTo("login", replace: true); return; }
        try
        {
            profile = await Profiles.GetOrCreateProfileAsync();
            plantings = await Plantings.GetAllAsync();
        }
        catch (Exception ex)
        {
            error = $"Could not load garden from Supabase: {ex.Message}";
        }
    }

    private void OpenPlantModal()
    {
        selectedCat = null;
        showEditModal = false;
        showDeleteModal = false;
        pickKey = null;
        noteInput = "";
        showPlantModal = true;
    }

    private void OpenEditModal()
    {
        if (selectedCat is null) return;
        pickKey = GardenState.Find(selectedCat.MoodName).Key;
        noteInput = selectedCat.Note ?? "";
        showEditModal = true;
    }

    private void CloseModals()
    {
        showPlantModal = false;
        showEditModal = false;
        showDeleteModal = false;
        selectedCat = null;
    }

    private void OpenInDiary()
    {
        if (selectedCat is null) return;
        var id = selectedCat.Id;
        CloseModals();
        Nav.NavigateTo($"diary?hl={id}");
    }

    private async Task SaveNewPlantingAsync()
    {
        if (string.IsNullOrEmpty(pickKey))
        {
            await ShowToastAsync("Pick a mood first");
            return;
        }
        saving = true;
        error = null;
        try
        {
            var mood = GardenState.Find(pickKey);
            var now = DateTime.UtcNow;
            var newPlanting = new Planting
            {
                Emoji = mood.Emoji,
                MoodName = mood.Name,
                X = Random.Shared.Next(10, 90),
                Y = Random.Shared.Next(35, 90),
                At = now,
                UpdatedAt = now,
                Note = string.IsNullOrWhiteSpace(noteInput) ? null : noteInput.Trim()
            };

            var created = await Plantings.AddAsync(newPlanting);
            plantings.Insert(0, created);
            CloseModals();

            var suffix = mood.Score < 3
                ? GardenState.KindMessages[Random.Shared.Next(GardenState.KindMessages.Length)]
                : "🌷";
            await ShowToastAsync($"{mood.Emoji} planted! {suffix}");
        }
        catch (Exception ex)
        {
            error = $"Save failed: {ex.Message}";
        }
        finally
        {
            saving = false;
        }
    }

    private async Task SaveEditAsync()
    {
        if (selectedCat is null || string.IsNullOrEmpty(pickKey)) return;
        saving = true;
        error = null;
        try
        {
            var mood = GardenState.Find(pickKey);
            var cleaned = string.IsNullOrWhiteSpace(noteInput) ? null : noteInput.Trim();
            await Plantings.UpdateEntryAsync(selectedCat.Id, mood.Emoji, mood.Name, cleaned);

            selectedCat.Emoji = mood.Emoji;
            selectedCat.MoodName = mood.Name;
            selectedCat.Note = cleaned;
            selectedCat.UpdatedAt = DateTime.UtcNow;
            CloseModals();
            await ShowToastAsync("Entry updated");
        }
        catch (Exception ex)
        {
            error = $"Update failed: {ex.Message}";
        }
        finally
        {
            saving = false;
        }
    }

    private async Task ConfirmDeleteAsync()
    {
        if (selectedCat is null) return;
        saving = true;
        error = null;
        try
        {
            await Plantings.SoftDeleteAsync(selectedCat.Id);
            plantings.RemoveAll(p => p.Id == selectedCat.Id);
            CloseModals();
            await ShowToastAsync("Entry deleted");
        }
        catch (Exception ex)
        {
            error = $"Delete failed: {ex.Message}";
        }
        finally
        {
            saving = false;
        }
    }

    private async Task ShowToastAsync(string msg)
    {
        toastMsg = msg;
        StateHasChanged();
        await Task.Delay(3200);
        if (toastMsg == msg)
        {
            toastMsg = null;
            StateHasChanged();
        }
    }
}
